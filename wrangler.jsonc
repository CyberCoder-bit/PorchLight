{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "porchlight",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  // src/i18n/index.js uses AsyncLocalStorage (node:async_hooks).
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "PORCHLIGHT", "class_name": "PorchLightData" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PorchLightData"] }],
  "observability": { "enabled": true }
}
