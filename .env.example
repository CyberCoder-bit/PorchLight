# Copy this file to .env and fill in what you need. .env is ignored by git,
# so your key stays on your computer.

# Turn on LIVE AI mode (Gemini writes the conversation sparks and translates messages).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# auto (default) = LIVE if a key is set, otherwise MOCK | mock = always offline | live
# SPARK_MODE=auto

# Models to try, in order (the next is used when one is busy):
# GEMINI_MODEL=gemini-flash-lite-latest,gemini-3-flash-preview
# On Cloudflare, Workers AI is the backup after Gemini (no key needed):
# WORKERS_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
# RISK_THRESHOLD_DAYS=7
# PORT=3000
